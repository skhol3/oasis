#!/usr/bin/env bash
set -Eeuo pipefail
export ODOO19_PROJECT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
export ODOO19_ENTRYPOINT="$0"
tools=${ODOO19_TOOLS_DIR:-$HOME/.agents/skills/odoo19/tools}
if [[ ! -f "$tools/check-environment" ]]; then printf 'Odoo 19 tools are not installed: %s\n' "$tools/check-environment" >&2; exit 2; fi
exec bash "$tools/check-environment" "$@"
