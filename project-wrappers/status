#!/usr/bin/env bash
set -Eeuo pipefail
export ODOO19_PROJECT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
tools=${ODOO19_TOOLS_DIR:-$HOME/.agents/skills/odoo19/tools}
if [[ ! -f "$tools/status" ]]; then printf 'Odoo 19 tools are not installed: %s\n' "$tools/status" >&2; exit 2; fi
exec bash "$tools/status" "$@"
