#!/usr/bin/env bash
set -Eeuo pipefail
export OASIS_PROJECT_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
tools=${OASIS_TOOLS_DIR:-$HOME/.agents/skills/oasis/tools}
if [[ ! -f "$tools/stop" ]]; then printf 'oasis tools are not installed: %s\n' "$tools/stop" >&2; exit 2; fi
exec bash "$tools/stop" "$@"
