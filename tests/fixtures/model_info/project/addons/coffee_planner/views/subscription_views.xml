<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_form" model="ir.ui.view">
        <field name="name">coffee.subscription.form</field>
        <field name="model">coffee.subscription</field>
        <field name="arch" type="xml">
            <form><field name="name"/></form>
        </field>
    </record>
    <record id="view_subscription_list" model="ir.ui.view">
        <field name="name">coffee.subscription.list</field>
        <field name="model">coffee.subscription</field>
        <field name="arch" type="xml">
            <list><field name="name"/></list>
        </field>
    </record>
    <record id="view_subscription_search" model="ir.ui.view">
        <field name="name">coffee.subscription.search</field>
        <field name="model">coffee.subscription</field>
        <field name="arch" type="xml">
            <search><field name="name"/></search>
        </field>
    </record>
    <record id="view_subscription_renew_form" model="ir.ui.view">
        <field name="name">coffee.subscription.renew.form</field>
        <field name="model">coffee.subscription.renew</field>
        <field name="arch" type="xml">
            <form><field name="months"/></form>
        </field>
    </record>
    <record id="action_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">coffee.subscription</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_server_renew" model="ir.actions.server">
        <field name="name">Renew now</field>
        <field name="model_id" ref="model_coffee_subscription"/>
        <field name="state">code</field>
        <field name="code">records.action_renew()</field>
    </record>
    <!-- The same id written again: listed once, with the count. -->
    <record id="action_server_renew" model="ir.actions.server">
        <field name="name">Renew now</field>
    </record>
    <menuitem id="menu_planner_root" name="Planner">
        <menuitem id="menu_planner_subscriptions" name="Subscriptions" action="action_subscription"/>
        <menuitem id="menu_planner_config" name="Configuration">
            <menuitem id="menu_planner_renew" name="Renew" action="action_server_renew"/>
        </menuitem>
    </menuitem>
    <menuitem id="menu_planner_reports" name="Planner reports" parent="base.menu_custom"/>
</odoo>
