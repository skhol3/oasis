<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_planner" model="ir.ui.view">
        <field name="name">account.move.form.planner</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after"><field name="subscription_id"/></field>
        </field>
    </record>
    <record id="view_move_form_planner_extra" model="ir.ui.view">
        <field name="name">account.move.form.planner.extra</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside"><div/></xpath>
        </field>
    </record>
    <record id="view_subscription_form_renew" model="ir.ui.view">
        <field name="name">coffee.subscription.form.renew</field>
        <field name="inherit_id" ref="view_subscription_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after"><field name="state"/></field>
        </field>
    </record>
</odoo>
