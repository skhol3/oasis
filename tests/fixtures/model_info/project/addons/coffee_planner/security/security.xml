<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_planner_manager" model="res.groups">
        <field name="name">Planner manager</field>
    </record>
    <record id="rule_subscription_user" model="ir.rule">
        <field name="name">Own subscriptions</field>
        <field name="model_id" ref="model_coffee_subscription"/>
        <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('group_planner_manager'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_subscription_line_global" model="ir.rule">
        <field name="name">Lines of active subscriptions</field>
        <field name="model_id" ref="model_coffee_subscription_line"/>
        <field name="domain_force">[('subscription_id.state', '=', 'active')]</field>
    </record>
</odoo>
