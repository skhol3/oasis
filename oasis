#!/usr/bin/env python3
"""Explicit-project entry point for the installed oasis tool bundle.

`oasis` is the entry point; `odoo19` is a compatibility alias that runs this same file, so every
command, option, exit code and output is identical. Help and usage name the invoked program.
"""
import argparse
import importlib.util
import os
from pathlib import Path
import sys

COMMANDS = (
    'audit-dependencies', 'bootstrap', 'check-environment', 'create-database', 'doctor',
    'drop-database', 'gc', 'init-dev-database', 'install-module', 'lint-module', 'list-databases',
    'menu', 'migrate', 'model-info', 'module-info', 'module-status', 'odoo-shell', 'restart', 'start',
    'status', 'stop', 'test-module', 'trash', 'update-module', 'verify-module', 'view-info',
    'worktree-init', 'xmlid-info',
)
PROGRAMS = ('oasis', 'odoo19')
# The invoked file. The odoo19 alias runs this file with runpy.run_path(..., init_globals=
# {'ALIAS_PATH': <its own path>}), because runpy rewrites argv[0] to this file; help, usage and
# OASIS_ENTRYPOINT then name the program the user actually ran.
INVOKED = Path(globals().get('ALIAS_PATH') or __file__)


# Commands that run in a checkout that still has the legacy profile: migrate converts it, doctor
# reports it as one FAIL. Every other command is refused before it runs.
LEGACY_COMMANDS = ('migrate', 'doctor')


def configuration_reader(tools: Path):
    """tools/config.py as a module (its finder and messages, not a copy), or None when missing."""
    reader = tools / 'config.py'
    if not reader.is_file():
        return None
    sys.dont_write_bytecode = True  # never leave __pycache__ in the installed bundle
    spec = importlib.util.spec_from_file_location('oasis_config', reader)
    config = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(config)
    return config


def program_name() -> str:
    """The invoked entry point (`odoo19` through its alias), else `oasis`."""
    return INVOKED.name if INVOKED.name in PROGRAMS else 'oasis'


def main() -> int:
    prog = program_name()
    parser = argparse.ArgumentParser(
        prog=prog,
        description='Run an installed oasis tool for an explicitly selected project.',
        epilog=('Commands: ' + ', '.join(COMMANDS) + '\n'
                f'Example: {prog} --project /absolute/project check-environment --quick'),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument('--project', metavar='/absolute/project',
                        help='absolute path to an existing checkout at or below an oasis-workspace.toml')
    parser.add_argument('command', nargs='?', help='public command to run')
    parser.add_argument('arguments', nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.command not in COMMANDS:
        print(f'ERROR: Unsupported oasis command: {args.command}', file=sys.stderr)
        return 2
    if not args.project or not Path(args.project).is_absolute() or not Path(args.project).is_dir():
        print('ERROR: --project requires an absolute existing project directory.', file=sys.stderr)
        return 2
    root = Path(args.project).resolve()
    tools = Path(__file__).resolve().parent / 'tools'
    config = configuration_reader(tools)
    if config is not None and (root / config.PROFILE_NAME).is_file():
        if args.command not in LEGACY_COMMANDS:
            print(f'ERROR: {config.legacy_profile_refusal(root / config.PROFILE_NAME, prog)}', file=sys.stderr)
            return 2
    elif config is None or config.find_workspace(root) is None:
        message = (config.missing_configuration(root) if config is not None
                   else f'Missing tooling configuration: no oasis-workspace.toml at or above {root}.')
        print(f'ERROR: {message}', file=sys.stderr)
        return 2
    tool = tools / args.command
    if not tool.is_file() or not tool.resolve().is_relative_to(tools):
        print(f'oasis tools are not installed: {tool}', file=sys.stderr)
        return 2
    env = os.environ.copy()
    # Both names of each variable, with the same value: the tools read OASIS_* first and the
    # legacy ODOO19_* when it is unset (tools/oasis_env.sh, tools/config.py variable()).
    for prefix in ('OASIS', 'ODOO19'):
        env[f'{prefix}_PROJECT_ROOT'] = str(root)
        env[f'{prefix}_ENTRYPOINT'] = str(INVOKED.resolve())
        env.pop(f'{prefix}_TOOLS_DIR', None)
    # argparse consumes a separator after the command; tool arguments must stay byte-for-byte.
    arguments = sys.argv[sys.argv.index(args.command, 1) + 1:]
    os.execve('/bin/bash', ['bash', str(tool), *arguments], env)
    return 0  # pragma: no cover - execve replaces this process


if __name__ == '__main__':
    raise SystemExit(main())
