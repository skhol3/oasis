#!/usr/bin/env python3
"""Entry point for the installed oasis tool bundle.

The project is `--project <dir>`, else the git top level of the current directory (the current
directory itself outside git). `oasis` is the entry point; `odoo19` is a compatibility alias that
runs this same file, so every command, option, exit code and output is identical. Help and usage
name the invoked program.
"""
import argparse
import importlib.util
import os
from pathlib import Path
import sys

COMMANDS = (
    'audit-dependencies', 'bootstrap', 'check-environment', 'create-database', 'doctor',
    'drop-database', 'gc', 'init-dev-database', 'install-module', 'lint-module', 'list-databases',
    'menu', 'migrate', 'model-info', 'module-info', 'module-status', 'odoo-shell', 'policy',
    'recreate-database-volume', 'restart', 'setup', 'start', 'status', 'stop', 'test-module', 'trash',
    'update-module', 'verify-module', 'view-info', 'worktree-init', 'xmlid-info',
)
PROGRAMS = ('oasis', 'odoo19')
# The invoked file. The odoo19 alias runs this file with runpy.run_path(..., init_globals=
# {'ALIAS_PATH': <its own path>}), because runpy rewrites argv[0] to this file; help, usage and
# OASIS_ENTRYPOINT then name the program the user actually ran.
INVOKED = Path(globals().get('ALIAS_PATH') or __file__)


# Commands that run in a checkout that still has the legacy profile: migrate converts it, doctor
# reports it as one FAIL, policy prints the agent contract. Every other command is refused before it runs.
LEGACY_COMMANDS = ('migrate', 'doctor', 'policy')
# Commands that run in a checkout without a workspace file: setup creates it, policy reads no
# configuration, and `status --json` reports that the workspace is missing (v0.16.0 S3). Every other
# command is refused there (missing configuration).
UNCONFIGURED_COMMANDS = ('doctor', 'policy', 'setup')
# Deprecated command names (v0.16.0 S5): each keeps working, with the same output and exit codes as the
# command it stands for (tools/policy.py ALIASES gives both the same tier).
DEPRECATED_ALIASES = {'check-environment': 'doctor --environment'}


def configuration_reader(tools: Path):
    """tools/config.py as a module (its finder and messages, not a copy), or None when missing."""
    reader = tools / 'config.py'
    if not reader.is_file():
        return None
    sys.dont_write_bytecode = True  # never leave __pycache__ in the installed bundle
    spec = importlib.util.spec_from_file_location('oasis_config', reader)
    config = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(config)
    return config


def program_name() -> str:
    """The invoked entry point (`odoo19` through its alias), else `oasis`."""
    return INVOKED.name if INVOKED.name in PROGRAMS else 'oasis'


def current_project(config) -> tuple[Path | None, str]:
    """The project without --project: the git top level of the current directory, or the current
    directory outside git (no `.git` at or above it). When git fails inside a repository the
    project is not guessed: (None, the error). config is tools/config.py (its git reading), or
    None when it is missing (the current directory; the missing configuration follows)."""
    try:
        cwd = Path.cwd().resolve()
    except OSError:
        return None, 'Cannot read the current directory; pass --project.'
    if config is None:
        return cwd, ''
    try:
        _kind, top, _main = config.git_checkout(cwd)
    except config.GitFailed as exc:
        if config.dot_git(cwd) is None:
            return cwd, ''
        return None, f'Cannot determine the project root of {cwd}: git failed ({exc}); pass --project.'
    return top, ''


def main() -> int:
    prog = program_name()
    parser = argparse.ArgumentParser(
        prog=prog,
        description=('Run an installed oasis tool for a project: --project, else the checkout of the '
                     'current directory.'),
        epilog=('Commands: ' + ', '.join(COMMANDS) + '\n'
                'Deprecated aliases (they keep working): '
                + ', '.join(f'{alias} runs {target}' for alias, target in DEPRECATED_ALIASES.items()) + '\n'
                'New checkout: the setup command prints the plan of its configuration; setup --apply '
                'creates it\n'
                f'Example: {prog} --project /absolute/project doctor --environment --quick\n'
                f'Example: cd /absolute/project && {prog} doctor --environment --quick'),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument('--project', metavar='/absolute/project',
                        help=('absolute path to an existing checkout at or below an oasis-workspace.toml '
                              '(a linked worktree may read its main checkout\'s); '
                              'without it, the git top level of the current directory (the current '
                              'directory outside git)'))
    parser.add_argument('command', nargs='?', help='public command to run')
    parser.add_argument('arguments', nargs=argparse.REMAINDER, help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.command not in COMMANDS:
        print(f'ERROR: Unsupported oasis command: {args.command}', file=sys.stderr)
        return 2
    # argparse consumes a separator after the command; tool arguments must stay byte-for-byte.
    arguments = sys.argv[sys.argv.index(args.command, 1) + 1:]
    # `doctor --environment` runs the environment checks, which need the configuration: refused where
    # check-environment, its deprecated alias (DEPRECATED_ALIASES), is.
    gated = 'check-environment' if args.command == 'doctor' and arguments[:1] == ['--environment'] else args.command
    tools = Path(__file__).resolve().parent / 'tools'
    if args.project is not None and (not args.project or not Path(args.project).is_absolute()
                                     or not Path(args.project).is_dir()):
        print('ERROR: --project requires an absolute existing project directory.', file=sys.stderr)
        return 2
    config = configuration_reader(tools)
    if args.project is not None:
        root = Path(args.project).resolve()
    else:
        root, error = current_project(config)
        if root is None:
            print(f'ERROR: {error}', file=sys.stderr)
            return 2
    if config is not None and (root / config.PROFILE_NAME).is_file():
        if gated not in LEGACY_COMMANDS:
            print(f'ERROR: {config.legacy_profile_refusal(root / config.PROFILE_NAME, prog)}', file=sys.stderr)
            return 2
    elif (gated not in UNCONFIGURED_COMMANDS and not (args.command == 'status' and args.arguments == ['--json'])
          and (config is None or config.workspace_file(root) is None)):
        message = (config.missing_configuration(root) if config is not None
                   else f'Missing tooling configuration: no oasis-workspace.toml at or above {root}.')
        print(f'ERROR: {message}', file=sys.stderr)
        return 2
    tool = tools / args.command
    if not tool.is_file() or not tool.resolve().is_relative_to(tools):
        print(f'oasis tools are not installed: {tool}', file=sys.stderr)
        return 2
    env = os.environ.copy()
    # Both names of each variable, with the same value: the tools read OASIS_* first and the
    # legacy ODOO19_* when it is unset (tools/oasis_env.sh, tools/config.py variable()).
    for prefix in ('OASIS', 'ODOO19'):
        env[f'{prefix}_PROJECT_ROOT'] = str(root)
        env[f'{prefix}_ENTRYPOINT'] = str(INVOKED.resolve())
        env.pop(f'{prefix}_TOOLS_DIR', None)
    os.execve('/bin/bash', ['bash', str(tool), *arguments], env)
    return 0  # pragma: no cover - execve replaces this process


if __name__ == '__main__':
    raise SystemExit(main())
