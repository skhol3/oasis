#!/usr/bin/env python3
"""Compatibility alias of the `oasis` entry point: it runs the same file, so every command,
option, exit code and output is identical; help and usage name `odoo19`."""
from pathlib import Path
import runpy
import sys

sys.dont_write_bytecode = True
runpy.run_path(str(Path(__file__).resolve().parent / 'oasis'), init_globals={'ALIAS_PATH': __file__},
               run_name='__main__')
