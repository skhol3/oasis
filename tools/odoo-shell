#!/usr/bin/env bash
set -Eeuo pipefail
if [[ ${1:-} == --help && $# == 1 ]]; then
  printf 'Usage: %s <database>\n' "${ODOO19_ENTRYPOINT:-$0}"
  printf 'Opens an Odoo shell on an existing managed database (dev_prefix/test_prefix, with the\n'
  printf 'checkout slug in a checkout that has one). A missing database is refused, never created.\n'
  exit 0
fi
source "$(dirname "$0")/common.sh"
database=${1:-}
require_runtime
if [[ -z "$database" ]]; then
  printf 'Usage: %s <database>\n' "${ODOO19_ENTRYPOINT:-$0}" >&2
  exit 2
fi
require_managed_database_name "$database"
odoo_config_arguments
# Preparation must not consume commands piped to the Odoo shell.
require_existing_database "$database" </dev/null
exec "$PYTHON" "$ODOO_BIN" shell "${ODOO_CONFIG_ARGUMENTS[@]}" -d "$database"
