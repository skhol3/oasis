#!/usr/bin/env bash
set -Eeuo pipefail
source "$(dirname "$0")/common.sh"
source "$(dirname "$0")/compact.sh"
mode=${1:---preview}
lockfile="$REQUIREMENTS_DIR/dev.txt"
required_paths=("$ODOO_BIN" "$ODOO_CONFIG" "$COMPOSE_FILE" "$ENV_FILE")
if (( $# > 1 )) || [[ "$mode" != "--preview" && "$mode" != "--apply" ]]; then
  printf 'Usage: %s [--preview|--apply]\n' "$(usage_name)" >&2
  exit 2
fi
for path in "${required_paths[@]}"; do
  if [[ ! -e "$path" ]]; then
    printf 'Missing required local path: %s\n' "$path" >&2
    exit 2
  fi
done
require_source
if ! command -v uv >/dev/null 2>&1; then
  printf 'uv is required to bootstrap this environment.\n' >&2
  printf 'Install uv (https://docs.astral.sh/uv/), then run %s bootstrap again.\n' "$(program_name)" >&2
  exit 2
fi
# The locks: current ones are left as they are (byte-identical); missing ones, or ones whose
# lock.sha256 no longer records the current runtime.in and dev.in (stale), are compiled from
# those inputs before the sync (tools/locks.py); a lock changed by hand under current inputs
# (edited) is refused, never overwritten. The inputs are only read. An optional overrides.txt there
# (v0.15.0 S7) is an input too: compiled with --override and recorded in lock.sha256, which
# `sha256sum --check` alone cannot require (locks.py recorded).
locks_state=current
overrides_recorded() {
  [[ ! -f "$REQUIREMENTS_DIR/overrides.txt" ]] \
    || python3 -I -B "$(dirname "$0")/locks.py" recorded "$REQUIREMENTS_DIR"
}
if [[ ! -f "$REQUIREMENTS_DIR/runtime.txt" || ! -f "$lockfile" ]] || ! dependency_locks_current \
    || ! overrides_recorded; then
  for path in "$REQUIREMENTS_DIR/runtime.in" "$REQUIREMENTS_DIR/dev.in"; do
    if [[ ! -f "$path" ]]; then
      printf 'Missing required local path: %s\n' "$path" >&2
      exit 2
    fi
  done
  locks_state=$(python3 -I -B "$(dirname "$0")/locks.py" state "$REQUIREMENTS_DIR")
fi
if [[ "$locks_state" == edited ]]; then
  inputs='runtime.in and dev.in' fingerprinted='runtime.in runtime.txt dev.in dev.txt'
  if [[ -f "$REQUIREMENTS_DIR/overrides.txt" ]]; then
    inputs='runtime.in, dev.in and overrides.txt' fingerprinted+=' overrides.txt'
  fi
  printf 'Refusing bootstrap because dependency inputs or locks do not match lock.sha256.\n' >&2
  printf '%s match it, so a lock was changed by hand: move that lock away for bootstrap to compile it again, or fingerprint it again in %s with sha256sum %s > lock.sha256.\n' \
    "$inputs" "$REQUIREMENTS_DIR" "$fingerprinted" >&2
  exit 2
fi
if [[ -e "$PROJECT_ENVIRONMENT" && ! -x "$PYTHON" ]]; then
  printf 'Refusing to replace a non-virtualenv path: %s\n' "$PROJECT_ENVIRONMENT" >&2
  exit 2
fi
# An existing isolated interpreter must be the declared Python ($PYTHON_VERSION: the series'
# default for [tooling].environment, else the selected named environment's python), even
# before a dry-run or repair. Odoo may lack dependencies until the requested sync completes.
if [[ -x "$PYTHON" ]]; then require_python_version; fi
printf 'mode=%s\n' "${mode#--}"
printf 'project=%s\n' "$PROJECT_NAME"
printf 'environment=%s\n' "$PROJECT_ENVIRONMENT"
printf 'lockfile=%s\n' "${lockfile#$PROJECT_ROOT/}"
if [[ "$mode" == "--preview" ]]; then
  printf 'mutation=none\n'
  if [[ "$locks_state" != current ]]; then
    # The lock to sync does not exist yet, so no dry-run sync: the plan names both steps.
    printf 'locks=%s\n' "$locks_state"
    if [[ -x "$PYTHON" ]]; then
      printf 'environment_state=ready\n'
      printf 'planned_action=compile_locks_then_sync_lock\n'
    else
      printf 'environment_state=missing\n'
      printf 'planned_action=compile_locks_then_create_python_%s_and_sync_lock\n' "$PYTHON_VERSION"
    fi
    exit 0
  fi
  if [[ -x "$PYTHON" ]]; then
    printf 'environment_state=ready\n'
    exec uv pip sync --dry-run --python "$PYTHON" "$lockfile"
  fi
  printf 'environment_state=missing\n'
  printf 'planned_action=create_python_%s_and_sync_lock\n' "$PYTHON_VERSION"
  exit 0
fi
printf 'mutation=isolated_project_virtualenv\n'
# uv 0.13 and later read old source archives (V7 tar headers) only with UV_LEGACY_TAR_BACKEND=1: exported
# for every uv command below when `uv --version` needs it and it is not set (tools/locks.py uv-env).
uv_env=$(python3 -I -B "$(dirname "$0")/locks.py" uv-env)
eval "$uv_env"
# The snapshot of the packages before the sync goes to the checkout's log directory
# (tools/log_dirs.py, created 0700), never under global tools; resolved before any change.
snapshot_dir=$(server_log_path)
snapshot_dir=${snapshot_dir%/*}
if [[ "$locks_state" != current ]]; then
  printf 'locks=%s\n' "$locks_state"
  # `uv pip compile <input> -o <lock>` in the requirements directory with the declared Python, as
  # docs/new-workspace.md runs it by hand: runtime.txt first (dev.in constrains itself with it), then
  # lock.sha256 (tools/locks.py compile, which oasis setup runs too; with --override overrides.txt
  # when that file exists). A failure stops before lock.sha256 and names the input.
  python3 -I -B "$(dirname "$0")/locks.py" compile "$REQUIREMENTS_DIR" "$PYTHON_VERSION" \
    "$(program_name) bootstrap --apply"
  printf 'locks_compiled=runtime.txt,dev.txt,lock.sha256\n'
fi
mkdir -p "$ENVIRONMENTS_DIR"
# The environment bootstrap creates carries oasis' mark (tools/environment_origin.py, v0.17.0 S1): its drift
# from the locks is a FAIL. An existing environment is never marked: when oasis did not create it (adopted),
# this explicit --apply is the one command that changes it, and a drift is a WARN.
if [[ ! -x "$PYTHON" ]]; then
  uv venv --python "$PYTHON_VERSION" "$PROJECT_ENVIRONMENT"
  # A mark that cannot be written is a warning on stderr (exit 1), not a failure: the environment is then adopted.
  python3 -I -B "$(dirname "$0")/environment_origin.py" mark "$PROJECT_ENVIRONMENT" "$(program_name) bootstrap --apply" \
    || true
  require_python_version
fi
uv pip freeze --python "$PYTHON" > "$snapshot_dir/bootstrap-before.txt"
uv pip sync --python "$PYTHON" "$lockfile"
require_runtime
# The trailing doctor (`doctor --environment --full`, v0.20.0 S4): the exit code reports bootstrap's own work, the
# locks and the sync, which succeeded by now (any failure above exits with its own code). A doctor that completed
# and reported failed checks outside the sync, such as PostgreSQL not running yet, is printed as a doctor result
# with the command to run next, and the exit stays 0. Completed means exit 1 and its summary line on stdout: any
# other non-zero exit (a doctor that did not run, 126/127, or died, a traceback or a signal 128+n) is bootstrap's
# exit, with one stderr line saying the doctor did not complete. The doctor's environment result for the
# environment just synced, its drift line on stderr (an environment oasis created that still drifts, a lock it
# cannot read, a comparison that crashed), is bootstrap's own result: the doctor's exit, with nothing added.
# The two doctor lines bootstrap reads, printed by tools/environment_checks.sh (tools/doctor runs it): the
# drift line at :89 (`fail "locked_environment=drifted"`, on stderr through fail() at :34) and the summary line
# at :127 (`environment_failures=<n>`, the last line on stdout). Changing either there changes bootstrap's exit.
doctor_drift_line='FAIL locked_environment=drifted'
doctor_summary_pattern='^environment_failures=[0-9]+$'
# Each stream of the doctor is passed through line by line as it comes (stdout to fd 3, stderr to fd 4) and
# its marker, when seen, is written to fd 5, which the caller reads: `drifted` on stderr, `summary` on stdout.
doctor_lines() {
  local stream=$1 line
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$stream" == stdout ]]; then
      printf '%s\n' "$line" >&3
      if [[ "$line" =~ $doctor_summary_pattern ]]; then printf 'summary\n' >&5; fi
    else
      printf '%s\n' "$line" >&4
      if [[ "$line" == "$doctor_drift_line" ]]; then printf 'drifted\n' >&5; fi
    fi
  done
}
doctor_exit=0
exec 3>&1 4>&2
# The doctor's stdout goes through fd 6 to the stdout filter, its stderr to the stderr filter; the doctor gets
# none of bootstrap's extra descriptors. pipefail gives the doctor's exit (both filters exit 0). The subshell's own
# stderr is /dev/null: bash's job report for a doctor killed by a signal (`Done ...`) is not a doctor line.
markers=$( { { "$(dirname "$0")/doctor" --environment --full 2>&1 1>&6 3>&- 4>&- 5>&- 6>&- \
  | doctor_lines stderr; } 6>&1 | doctor_lines stdout; } 5>&1 1>/dev/null 2>/dev/null ) || doctor_exit=$?
exec 3>&- 4>&-
markers=$'\n'"$markers"$'\n'
if [[ "$markers" == *$'\ndrifted\n'* ]]; then
  exit "$doctor_exit"
fi
if (( doctor_exit == 0 )); then
  exit 0
fi
if (( doctor_exit == 1 )) && [[ "$markers" == *$'\nsummary\n'* ]]; then
  printf 'sync=succeeded\n'
  printf 'doctor=failed exit=%s: the checks above are the results of the trailing doctor --environment --full; the sync succeeded\n' \
    "$doctor_exit"
  printf '  next: fix what they report (their fix: lines), then run %s\n' \
    "$(confirm_command doctor --environment --full)"
  exit 0
fi
cause='no environment_failures= summary line'
if [[ "$markers" == *$'\nsummary\n'* ]]; then
  cause="it printed its summary but exited $doctor_exit, not a check result"
fi
printf 'doctor=incomplete exit=%s: the trailing doctor --environment --full did not complete (%s); the sync succeeded; run %s\n' \
  "$doctor_exit" "$cause" "$(confirm_command doctor --environment --full)" >&2
exit "$doctor_exit"
