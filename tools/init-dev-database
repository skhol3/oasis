#!/usr/bin/env bash
# Creates a new development database with its accounts (tools/dev_users.py). Tier B in the agent policy
# (tools/policy.py, v0.20.0 S5): it creates it only with --confirm <database>, the database it names; without
# it, or with another name, it refuses (exit 2) naming the exact command once the configuration is checked, and
# nothing changes. --dry-run prints what it would create and changes nothing. --plan (tools/database_plan.py,
# v0.20.0 S6) asks the name, the module and the demo data first.
set -Eeuo pipefail
if [[ ${1:-} == --help && $# == 1 ]]; then
  printf '%s\n' 'Usage: init-dev-database [--with-demo] <module> <database>' \
    '       ... <module> <database> --dry-run | --confirm <database>' \
    '       init-dev-database --plan [--json] [--answer <id>=<value>]... [--answers <file.json>]' \
    'Create a NEW development database with explicit administrator and project role accounts.' \
    'Tier B (oasis policy --json): it creates the database only with --confirm <database>, the name it is given;' \
    'without it it refuses naming the exact command and changes nothing. --dry-run prints the database, its kind,' \
    'the module and the demo data and changes nothing. --plan asks the name (the suffix after the dev prefix), the' \
    'module and the demo data, then prints the dry run and the --confirm command (docs/dev-database.md).' \
    'Requires [development] configuration; excludes tests. On a terminal it asks each password with the echo' \
    'off (Enter generates one); otherwise it generates them. Generated passwords go to <database>.logins next' \
    'to the env file (mode 0600), never to the output.' \
    '--with-demo opts in to the native Odoo demo loader and project development.demo_modules.'
  exit 0
fi
source "$(dirname "$0")/common.sh"
if [[ ${1:-} == --plan ]]; then
  exec python3 -I -B "$(dirname "$0")/database_plan.py" init-dev-database "${@:2}"
fi
with_demo=false
demo_option=()
if [[ ${1:-} == --with-demo ]]; then
  with_demo=true
  demo_option=("$1")
  shift
fi
arguments=()
dry_run=false
confirm=
confirmed=false
usage_error=false
for (( index = 1; index <= $#; index++ )); do
  argument=${!index}
  case $argument in
    --dry-run) "$dry_run" && usage_error=true; dry_run=true ;;
    --confirm|--confirm=*)
      "$confirmed" && usage_error=true
      confirmed=true
      if [[ "$argument" == --confirm ]]; then
        index=$(( index + 1 ))
        confirm=${!index:-}
      else
        confirm=${argument#--confirm=}
      fi
      [[ -n "$confirm" && "$confirm" != -* ]] || usage_error=true ;;
    --*) usage_error=true ;;
    *) arguments+=("$argument") ;;
  esac
done
if "$usage_error" || (( ${#arguments[@]} != 2 )); then
  printf 'Usage: init-dev-database [--with-demo] <module> <database>\n' >&2
  printf '       ... <module> <database> --dry-run | --confirm <database>; or init-dev-database --plan [--json]\n' >&2
  exit 2
fi
module=${arguments[0]}
database=${arguments[1]}
if [[ ! "$database" =~ ^[A-Za-z0-9_]+$ || "$database" != "$DEV_PREFIX"* || "$database" == "$DEV_PREFIX" ]]; then
  printf 'ERROR: Initialization requires a named development database.\n' >&2
  exit 2
fi
require_working_database_name "$database"
require_module "$module"
# A linked worktree's odoo.conf must be readable before any prompt or service call.
odoo_config_arguments
helper="$(dirname "$0")/dev_users.py"
python3 -B "$helper" --validate "$PROJECT_ROOT" "$module" "$database" "$with_demo"
demo=no
if "$with_demo"; then demo=yes; fi
if "$dry_run"; then
  printf 'database: %s\nkind: dev\nmodule: %s\ndemo: %s\ndry run: nothing changed\n' "$database" "$module" "$demo"
  exit 0
fi
if [[ "$confirm" != "$database" ]]; then
  command=$(confirm_command init-dev-database "${demo_option[@]}" "$module" "$database" --confirm "$database")
  if "$confirmed"; then
    printf 'ERROR: --confirm %s does not name the database %s; nothing changed. Run: %s\n' \
      "$confirm" "$database" "$command" >&2
  else
    printf 'ERROR: init-dev-database creates the development database %s with its accounts and installs %s, demo data: %s (Tier B: it needs explicit confirmation); nothing changed. Run: %s\n' \
      "$database" "$module" "$demo" "$command" >&2
  fi
  exit 2
fi
require_runtime
exec python3 -B "$helper" "$PROJECT_ROOT" "$module" "$database" "$with_demo"
