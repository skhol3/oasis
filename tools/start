#!/usr/bin/env bash
set -Eeuo pipefail
# Options, including --help, go to odoo-bin; only database selections are guarded.
# Each checkout runs at most one server, recorded with its pid and HTTP port by
# tools/runtime_state.py: the main checkout (or a project outside git) uses the odoo.conf
# http_port (8069 when absent), a linked worktree the first free port after it; an explicit
# -p/--http-port wins. The record also names the database given with -d/--database, if any. A
# linked worktree also gets a free second (gevent or longpolling) port, passed with the series' option
# ($ODOO_SECOND_PORT_OPTION from config.py) unless one is given. A server started without
# -d/--database prints `WARNING: no database given (-d); Odoo will use odoo.conf's db_name (<name>).`
# to stderr when odoo.conf names one (server_args.sh warn_without_database); nothing else changes.
# A batch run (--stop-after-init) serves nothing: no server check, no port check, no record;
# like test runs it gets a free ephemeral --http-port and a distinct free second port (explicit
# ones are passed as given).
# --detach, as the first argument only, runs the server in its own session instead of in the
# foreground: stdin from /dev/null, stdout and stderr appended to the checkout's server.log (the
# compact log directory: <logs>/<slug or main>/, [tooling].logs or else logs next to the workspace file). It
# prints pid=<pid> port=<port> log=<path> and returns once the server accepts connections on its
# HTTP interface (tools/runtime_state.py detach): --http-interface (or an unambiguous prefix of it,
# as Odoo reads it) when given, else the odoo.conf http_interface, 127.0.0.1 for none, 0.0.0.0 or
# ::. A server that does not listen in time is stopped and its record removed (exit 1). The record,
# the port rules and stop are the same. A batch run cannot be detached.
# --print-command, as the first argument only (then --detach may follow, which changes nothing),
# prints the odoo-bin command line start would exec as one shell-quoted line (shlex.join) on stdout
# and exits 0: the same configuration options, port choice (and its probes) and passed options, the
# values of password options shown as *** (server_args.sh print_server_command). Nothing else runs:
# no database service, no odoo-bin (not even --version), no record, no log, no banner or warning.
# Refusals are start's. --print-command anywhere else before `--` is refused (exit 2).
# Odoo creates a database it is given that does not exist (v0.20.0 L19): before Odoo starts, a server or a batch run
# checks that the database of -d, else (where the series reads it) each one of PGDATABASE, else each one of the db_name of the configuration
# file Odoo reads (a later -c/--config, else odoo.conf), exists, and refuses a missing one (exit 2) naming
# create-database --plan (server_args.sh server_databases, require_existing_server_databases). Without a database from
# any source (Odoo's database selector) nothing is checked; --print-command and Odoo's informational options never check.
source "$(dirname "$0")/common.sh"
print_command=false detach=false
if [[ ${1:-} == --print-command ]]; then
  print_command=true
  shift
fi
if [[ ${1:-} == --detach ]]; then
  detach=true
  shift
fi
for argument in "$@"; do
  if [[ "$argument" == -- ]]; then break; fi
  if [[ "$argument" == --print-command ]]; then
    printf -- '--print-command must be the first argument.\n' >&2
    exit 2
  fi
done
if "$print_command"; then
  require_runtime_paths
else
  require_runtime
fi
# Guard every database odoo-bin would receive, including optparse's unambiguous
# abbreviations of --database, before the database service is touched (tools/server_args.sh).
source "$(dirname "$0")/server_args.sh"
parse_server_arguments "$@"
odoo_config_arguments
if "$informational"; then
  # Odoo prints and exits: no server, no port, no record.
  if "$print_command"; then
    print_server_command "$PYTHON" "$ODOO_BIN" "${ODOO_CONFIG_ARGUMENTS[@]}" "$@"
    exit 0
  fi
  wait_for_database
  exec "$PYTHON" "$ODOO_BIN" "${ODOO_CONFIG_ARGUMENTS[@]}" "$@"
fi
if "$batch"; then
  if "$detach"; then
    printf -- '--detach starts a server; it cannot be combined with --stop-after-init.\n' >&2
    exit 2
  fi
  port_arguments=()
  batch_port=$explicit_port
  if [[ -z "$explicit_port" ]]; then
    batch_port=$(runtime_state ephemeral-port)
    port_arguments+=("--http-port=$batch_port")
  fi
  if ! "$explicit_gevent"; then
    # Distinct from the HTTP port; an explicit one that is not a valid port (1-65535) excludes
    # nothing and still reaches Odoo as given.
    if [[ ! "$batch_port" =~ ^[0-9]{1,5}$ ]] || (( 10#$batch_port < 1 || 10#$batch_port > 65535 )); then
      batch_port=''
    else
      batch_port=$(( 10#$batch_port ))
    fi
    second_port=$(runtime_state ephemeral-port ${batch_port:+"$batch_port"})
    port_arguments+=("$ODOO_SECOND_PORT_OPTION=$second_port")
  fi
  if "$print_command"; then
    print_server_command "$PYTHON" "$ODOO_BIN" "${ODOO_CONFIG_ARGUMENTS[@]}" "${port_arguments[@]}" "$@"
    exit 0
  fi
  require_existing_server_databases
  wait_for_database
  exec "$PYTHON" "$ODOO_BIN" "${ODOO_CONFIG_ARGUMENTS[@]}" "${port_arguments[@]}" "$@"
fi
server=$(runtime_state show "$PROJECT_ROOT")
if [[ -n "$server" ]]; then
  read -r running_pid running_port <<< "$server"
  printf 'Odoo is already running for this checkout: pid %s, port %s; run %s stop first.\n' \
    "${running_pid#pid=}" "${running_port#port=}" "$(program_name)" >&2
  exit 2
fi
interface=$(server_interface)
choose_server_ports
if "$print_command"; then
  print_server_command "$PYTHON" "$ODOO_BIN" "${ODOO_CONFIG_ARGUMENTS[@]}" "${port_arguments[@]}" "$@"
  exit 0
fi
if "$detach"; then
  source "$(dirname "$0")/compact.sh"
  log=$(server_log_path)
fi
require_existing_server_databases
warn_without_database
wait_for_database
if "$detach"; then
  exec python3 -I -B "$(dirname "$0")/runtime_state.py" detach "$PROJECT_ROOT" "$port" "$log" \
    "$ODOO_BIN" "$PYTHON" "$interface" "$explicit_database" -- \
    "${ODOO_CONFIG_ARGUMENTS[@]}" "${port_arguments[@]}" "$@"
fi
# $$ survives exec: the record names the Odoo process itself.
runtime_state record "$PROJECT_ROOT" "$$" "$port" "$ODOO_BIN" "$PYTHON" "$explicit_database"
printf '%s start: http://localhost:%s (pid %s)\n' "$(program_name)" "$port" "$$" >&2
exec "$PYTHON" "$ODOO_BIN" "${ODOO_CONFIG_ARGUMENTS[@]}" "${port_arguments[@]}" "$@"
