#!/usr/bin/env bash
set -Eeuo pipefail
# Options, including --help, go to odoo-bin; only database selections are guarded.
# Each checkout runs at most one server, recorded with its pid and HTTP port by
# tools/runtime_state.py: the main checkout (or a project outside git) uses the odoo.conf
# http_port (8069 when absent), a linked worktree the first free port after it; an explicit
# -p/--http-port wins. A linked worktree also gets a free second (gevent) port, passed with the
# Odoo series' option ($ODOO_SECOND_PORT_OPTION from config.py) unless one is given.
# A batch run (--stop-after-init) serves nothing: no server check, no port check, no record;
# like test runs it gets a free ephemeral --http-port and a distinct free second port (explicit
# ones are passed as given).
# --detach, as the first argument only, runs the server in its own session instead of in the
# foreground: stdin from /dev/null, stdout and stderr appended to the checkout's server.log (the
# compact log directory: <logs>/<slug or main>/ with [tooling].logs, else dev/logs/odoo19/). It
# prints pid=<pid> port=<port> log=<path> and returns once the server accepts connections on its
# HTTP interface (tools/runtime_state.py detach): --http-interface when given, else the odoo.conf
# http_interface, 127.0.0.1 for none, 0.0.0.0 or ::. A server that does not listen in time is
# stopped and its record removed (exit 1). The record, the port rules and stop are the same. A
# batch run cannot be detached.
source "$(dirname "$0")/common.sh"
require_runtime
detach=false
if [[ ${1:-} == --detach ]]; then
  detach=true
  shift
fi
# Guard every database odoo-bin would receive, including optparse's unambiguous
# abbreviations of --database, before the database service is touched.
arguments=("$@")
explicit_port=''
explicit_interface=''
interface_given=false
explicit_gevent=false
informational=false
batch=false
for (( index = 0; index < ${#arguments[@]}; index++ )); do
  case ${arguments[index]} in
    --) break ;;
    -d|--datab|--databa|--databas|--database)
      require_working_database_name "${arguments[index + 1]:-}"
      (( index += 1 )) ;;
    -d*) require_working_database_name "${arguments[index]#-d}" ;;
    --datab=*|--databa=*|--databas=*|--database=*)
      require_working_database_name "${arguments[index]#*=}" ;;
    -p|--http-port)
      explicit_port=${arguments[index + 1]:-}
      (( index += 1 )) ;;
    -p*) explicit_port=${arguments[index]#-p} ;;
    --http-port=*) explicit_port=${arguments[index]#*=} ;;
    --http-interface)
      interface_given=true
      explicit_interface=${arguments[index + 1]:-}
      (( index += 1 )) ;;
    --http-interface=*) interface_given=true; explicit_interface=${arguments[index]#*=} ;;
    "$ODOO_SECOND_PORT_OPTION") explicit_gevent=true; (( index += 1 )) ;;
    "$ODOO_SECOND_PORT_OPTION"=*) explicit_gevent=true ;;
    -h|--help|--version) informational=true ;;
    --stop-after-init) batch=true ;;
  esac
done
odoo_config_arguments
if "$informational"; then
  # Odoo prints and exits: no server, no port, no record.
  wait_for_database
  exec "$PYTHON" "$ODOO_BIN" "${ODOO_CONFIG_ARGUMENTS[@]}" "$@"
fi
if "$batch"; then
  if "$detach"; then
    printf -- '--detach starts a server; it cannot be combined with --stop-after-init.\n' >&2
    exit 2
  fi
  port_arguments=()
  batch_port=$explicit_port
  if [[ -z "$explicit_port" ]]; then
    batch_port=$(runtime_state ephemeral-port)
    port_arguments+=("--http-port=$batch_port")
  fi
  if ! "$explicit_gevent"; then
    # Distinct from the HTTP port; an explicit one that is not a valid port (1-65535) excludes
    # nothing and still reaches Odoo as given.
    if [[ ! "$batch_port" =~ ^[0-9]{1,5}$ ]] || (( 10#$batch_port < 1 || 10#$batch_port > 65535 )); then
      batch_port=''
    else
      batch_port=$(( 10#$batch_port ))
    fi
    second_port=$(runtime_state ephemeral-port ${batch_port:+"$batch_port"})
    port_arguments+=("$ODOO_SECOND_PORT_OPTION=$second_port")
  fi
  wait_for_database
  exec "$PYTHON" "$ODOO_BIN" "${ODOO_CONFIG_ARGUMENTS[@]}" "${port_arguments[@]}" "$@"
fi
# probe <first> <last> [<excluded>...]: sets found to the first free port, returns 1 when none.
# Any other bind failure exits 2 with runtime_state.py's `Cannot bind port <p>: <reason>.`.
probe() {
  local status=0
  found=$(runtime_state port "$interface" "$@") || status=$?
  if (( status == 2 )); then exit 2; fi
  return "$status"
}
# busy <port> <what to pass>: why the port is busy and what to do. A live record of another
# checkout on that port names its checkout (runtime_state others); otherwise it is another process.
busy() {
  local port=$1 pass=$2 line
  while IFS= read -r line; do
    if [[ "$line" =~ ^(.*)\ \(port\ ([0-9]+),\ pid\ ([0-9]+)\)$ && "${BASH_REMATCH[2]}" == "$port" ]]; then
      printf 'Port %s is in use by checkout %s (pid %s); %s or run %s stop in that checkout.\n' \
        "$port" "${BASH_REMATCH[1]}" "${BASH_REMATCH[3]}" "$pass" "$(program_name)" >&2
      return
    fi
  done < <(runtime_state others "$PROJECT_ROOT" 2>/dev/null || true)
  printf 'Port %s is in use by another process; %s or stop that process.\n' "$port" "$pass" >&2
}
server=$(runtime_state show "$PROJECT_ROOT")
if [[ -n "$server" ]]; then
  read -r running_pid running_port <<< "$server"
  printf 'Odoo is already running for this checkout: pid %s, port %s; run %s stop first.\n' \
    "${running_pid#pid=}" "${running_port#port=}" "$(program_name)" >&2
  exit 2
fi
# The address Odoo binds: an explicit --http-interface wins over the conf's http_interface.
if "$interface_given"; then
  interface=$explicit_interface
else
  interface=$(odoo_conf_option http_interface)
fi
port_arguments=()
if [[ -n "$explicit_port" ]]; then
  if [[ ! "$explicit_port" =~ ^[0-9]{1,5}$ ]] || (( 10#$explicit_port < 1 || 10#$explicit_port > 65535 )); then
    printf 'Invalid HTTP port: %s\n' "$explicit_port" >&2
    exit 2
  fi
  port=$(( 10#$explicit_port ))
  if ! probe "$port" "$port"; then
    busy "$port" 'pass another --http-port'
    exit 2
  fi
else
  conf_port=$(odoo_conf_option http_port)
  conf_port=${conf_port:-8069}
  if [[ "${CHECKOUT_KIND:-}" == linked ]]; then
    if ! probe $(( conf_port + 1 )) $(( conf_port + 50 )); then
      printf 'No free HTTP port from %s to %s; pass --http-port or stop another server.\n' \
        $(( conf_port + 1 )) $(( conf_port + 50 )) >&2
      exit 2
    fi
    port=$found
  else
    port=$conf_port
    if ! probe "$port" "$port"; then
      busy "$port" 'pass --http-port'
      exit 2
    fi
  fi
  port_arguments+=("--http-port=$port")
fi
if [[ "${CHECKOUT_KIND:-}" == linked ]] && ! "$explicit_gevent"; then
  gevent_port=$(odoo_conf_option gevent_port)
  gevent_port=${gevent_port:-8072}
  if ! probe $(( gevent_port + 1 )) $(( gevent_port + 50 )) "$port"; then
    printf 'No free gevent port from %s to %s; pass %s or stop another server.\n' \
      $(( gevent_port + 1 )) $(( gevent_port + 50 )) "$ODOO_SECOND_PORT_OPTION" >&2
    exit 2
  fi
  gevent=$found
  port_arguments+=("$ODOO_SECOND_PORT_OPTION=$gevent")
fi
if "$detach"; then
  source "$(dirname "$0")/compact.sh"
  log=$(server_log_path)
fi
wait_for_database
if "$detach"; then
  exec python3 -I -B "$(dirname "$0")/runtime_state.py" detach "$PROJECT_ROOT" "$port" "$log" \
    "$ODOO_BIN" "$PYTHON" "$interface" -- "${ODOO_CONFIG_ARGUMENTS[@]}" "${port_arguments[@]}" "$@"
fi
# $$ survives exec: the record names the Odoo process itself.
runtime_state record "$PROJECT_ROOT" "$$" "$port" "$ODOO_BIN" "$PYTHON"
printf '%s start: http://localhost:%s (pid %s)\n' "$(program_name)" "$port" "$$" >&2
exec "$PYTHON" "$ODOO_BIN" "${ODOO_CONFIG_ARGUMENTS[@]}" "${port_arguments[@]}" "$@"
