#!/usr/bin/env bash
set -Eeuo pipefail
source "$(dirname "$0")/oasis_env.sh"
if [[ ${1:-} == --help ]]; then
  printf 'Usage: %s [--compact] [--only <Class[.method]>] [--reuse] <module> [test_database]\n' "$(usage_name)"
  printf -- '--reuse keeps a working test database between runs: the explicit test_database, else\n'
  printf 'tooling.test_database, else test_prefix + [slug_] + module. When it exists with the module\n'
  printf 'installed, the run updates the module and runs the tests; otherwise it is reset and the\n'
  printf 'module installed. It is never dropped at the end: run without --reuse for a clean result.\n'
  printf -- '--only runs the tests of one class of the module, or one method of it (Class.method). The\n'
  printf 'module is still installed in the test database first.\n'
  printf 'Without a test_database argument or tooling.test_database, each run uses a new disposable\n'
  printf 'database test_prefix + module + _r<6 hex> (test_prefix + slug_ + module + ... in a checkout\n'
  printf 'with a slug; shortened with a hash to fit 56 bytes), created for the run and always dropped\n'
  printf 'with its filestore at the end, also on failure or Ctrl+C. A run that was killed leaves it\n'
  printf 'behind: %s gc lists such databases and %s gc --apply drops them.\n' "$(program_name)" "$(program_name)"
  printf 'An explicit test_database or tooling.test_database is reset and reused; run shared targets\n'
  printf 'sequentially. Explicit names must use the checkout namespace and are limited to 63 bytes;\n'
  printf 'names ending in _r<6 hex> (optionally _update) are reserved for disposable runs.\n'
  printf -- '--compact retains stdout/stderr under <logs>/<slug or main>/: [tooling].logs, else logs\n'
  printf 'next to the workspace file.\n'
  printf 'Tests use private short scratch; browser diagnostics remain under the same directory.\n'
  printf 'The test server gets its own free --http-port and a free second (gevent) port, so it never\n'
  printf 'collides with a running server.\n'
  exit 0
fi
source "$(dirname "$0")/common.sh"
compact=false
reuse=false
# Internal: a compact run passes the disposable name it reports to the run it starts.
run_database=''
only_arguments=()
while [[ ${1:-} == --* ]]; do
  case $1 in
    --compact) compact=true; shift ;;
    --disposable-run) run_database=${2:-}; shift $(( $# < 2 ? $# : 2 )) ;;
    --only) only_arguments=(--only "${2:-}"); shift $(( $# < 2 ? $# : 2 )) ;;
    --reuse) reuse=true; shift ;;
    *) break ;;
  esac
done
# One test class, or one method of it: the only text that reaches --test-tags besides the module.
only=${only_arguments[1]:-}
if (( ${#only_arguments[@]} )) && [[ ! "$only" =~ ^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)?$ ]]; then
  printf -- '--only takes a test class or Class.method.\n' >&2
  exit 2
fi
# Whether --test-tags takes a class filter depends on the Odoo series (odoo_versions.py).
if (( ${#only_arguments[@]} )) &&
    [[ "$(python3 -I -B "$(dirname "$0")/odoo_versions.py" "$ODOO_VERSION" test_class_filter)" != true ]]; then
  printf -- '--only is not available for Odoo %s.\n' "$ODOO_VERSION" >&2
  exit 2
fi
module=${1:-}
require_runtime
require_module "$module"
disposable=false
if [[ -n ${2:-} ]]; then
  database=$2
elif [[ -n "$TEST_DATABASE" ]]; then
  database=$TEST_DATABASE
elif "$reuse"; then
  # The working database of this module in the checkout's test namespace.
  database=$(checkout_database_name "$TEST_PREFIX" "$module")
else
  disposable=true
  database=${run_database:-$(new_disposable_database_name "$module")}
fi
require_database_name "$database"
if [[ "$database" != "$TEST_PREFIX"* ]]; then
  printf 'Test databases must use the %s prefix.\n' "$TEST_PREFIX" >&2
  exit 2
fi
if "$disposable"; then
  require_disposable_database_name "$database"
  require_update_sibling_room "$database"
else
  # An explicit or configured name may not carry the reserved run suffix.
  require_working_database_name "$database"
fi
if "$compact"; then
  source "$(dirname "$0")/compact.sh"
  log_directory=$(compact_log_directory)
  status=0
  run_arguments=("${only_arguments[@]}" "$module" "$database")
  # A reused database: the run writes how it prepared it (install or update) to this new file.
  unset OASIS_REUSE_RESULT
  if "$reuse"; then
    run_arguments=(--reuse "${run_arguments[@]}")
    export OASIS_REUSE_RESULT="$log_directory/database_lifecycle"
  fi
  # A disposable run (tools/test_temp.py) writes its own cleanup result, `yes` (it left no
  # database behind: dropped, or never created) or `no`, to a new file of this private log
  # directory; a run that ends without writing it (killed) counts as `no`.
  unset OASIS_RUN_RESULT
  if "$disposable"; then
    run_arguments=(--disposable-run "$database" "${only_arguments[@]}" "$module")
    export OASIS_RUN_RESULT="$log_directory/database_lifecycle"
  fi
  # A fresh Bash process preserves errexit inside reset_test_database.
  # Calling the function in an &&/|| context would disable its fail-closed checks.
  bash "$0" "${run_arguments[@]}" \
    >"$log_directory/stdout.log" 2>"$log_directory/stderr.log" || status=$?
  chmod 600 "$log_directory/stdout.log" "$log_directory/stderr.log"
  printf 'phase=tests database=%s exit=%s\n' "$database" "$status"
  if "$disposable"; then
    dropped=no
    if [[ -f "$OASIS_RUN_RESULT" && ! -L "$OASIS_RUN_RESULT" && "$(<"$OASIS_RUN_RESULT")" == yes ]]; then
      dropped=yes
    fi
    printf 'database_lifecycle=disposable dropped=%s\n' "$dropped"
  fi
  if "$reuse"; then
    mode=unknown
    if [[ -f "$OASIS_REUSE_RESULT" && ! -L "$OASIS_REUSE_RESULT" ]]; then
      case "$(<"$OASIS_REUSE_RESULT")" in install) mode=install ;; update) mode=update ;; esac
    fi
    printf 'database_lifecycle=reused mode=%s\n' "$mode"
  fi
  printf 'stdout_log=%s\nstderr_log=%s\n' "$log_directory/stdout.log" "$log_directory/stderr.log"
  exit "$status"
fi
odoo_config_arguments
# The test server binds its own free ports (HTTP, and the second port HttpCase tests use), so a
# test run never collides with a dev server.
http_port=$(runtime_state ephemeral-port)
second_port=$(runtime_state ephemeral-port "$http_port")
# A reused database that already has the module installed is updated instead of reset.
module_arguments=(-i "$module" "${ODOO_DEMO_OFF_ARGUMENTS[@]}")
if "$reuse"; then
  state=missing
  # A failing state query stops the run (module_state returns its status and this assignment is
  # not a condition), instead of looking like "not installed" and resetting the database.
  if database_exists "$database"; then state=$(module_state "$module" "$database"); fi
  mode=install
  if [[ "$state" == installed ]]; then
    mode=update
    module_arguments=(-u "$module")
  fi
  if [[ -n ${OASIS_REUSE_RESULT:-} ]]; then printf '%s\n' "$mode" >"$OASIS_REUSE_RESULT"; fi
fi
# --stop-after-init in every series: where --test-tags does not imply it (odoo_versions.py
# test_tags_implies_stop false, 15.0), Odoo would keep serving after the tests.
odoo_command=("$PYTHON" "$ODOO_BIN" "${ODOO_CONFIG_ARGUMENTS[@]}" "--http-port=$http_port"
  "$ODOO_SECOND_PORT_OPTION=$second_port" -d "$database" "${module_arguments[@]}" --test-tags "/$module${only:+:$only}" --stop-after-init)
if "$disposable"; then
  # test_temp.py owns the whole disposable lifecycle and the signals; exec keeps this pid.
  # OASIS_RUN_RESULT, when set, comes from the --compact parent above (internal).
  exec python3 -B "$(dirname "$0")/test_temp.py" --disposable "$database" "$ODOO_CONFIG" \
    "$PROJECT_ROOT" "${odoo_command[@]}"
fi
if ! "$reuse" || [[ "$mode" == install ]]; then
  reset_test_database "$database"
fi
python3 -B "$(dirname "$0")/test_temp.py" "$PROJECT_ROOT" "${odoo_command[@]}"
