#!/usr/bin/env bash
set -Eeuo pipefail
if [[ ${1:-} == --help ]]; then
  printf 'Usage: %s [--compact] <module> [test_database] [update_database]\n' "${ODOO19_ENTRYPOINT:-$0}"
  printf 'Runs two distinct test targets: tests and current-code fresh-install/update baseline.\n'
  printf 'Without a test_database argument or tooling.test_database both are disposable: a new\n'
  printf 'test_prefix + module + _r<6 hex> database (with slug_ after the prefix in a checkout with a\n'
  printf 'slug) and its _update sibling, dropped with their filestores at the end, also on failure or\n'
  printf 'Ctrl+C; odoo19 gc drops what a killed run left behind. Otherwise both are reset and reused:\n'
  printf 'tooling.test_database and its _update sibling, or the explicit names. Explicit names must\n'
  printf 'use the checkout namespace and may not end in _r<6 hex> (reserved for disposable runs).\n'
  printf 'A test database with an _update sibling is limited to 56 bytes.\n'
  printf 'Run shared targets sequentially. --compact retains per-phase stdout/stderr under odoo19/ of\n'
  printf 'the profile'\''s logs directory (default dev/logs); with [tooling].logs, in odoo19/<slug or main>.\n'
  printf 'The tests phase runs on its own free --http-port, so it never collides with a running server.\n'
  exit 0
fi
source "$(dirname "$0")/common.sh"
compact=false
if [[ ${1:-} == --compact ]]; then compact=true; shift; fi
module=${1:-}
require_runtime
if [[ -z "$module" || $# -gt 3 ]]; then
  printf 'Usage: %s <module> [%sdatabase] [%supdate_database]\n' "${ODOO19_ENTRYPOINT:-$0}" "$TEST_PREFIX" "$TEST_PREFIX" >&2
  exit 2
fi
require_module "$module"
disposable=false
# The run's own disposable names are managed names; explicit or configured names may not
# carry the reserved run suffix.
name_guard=require_working_database_name
if [[ -z ${2:-} && -z "$TEST_DATABASE" ]]; then
  disposable=true
  name_guard=require_managed_database_name
  test_database=$(new_disposable_database_name "$module")
  update_database=${test_database}_update
else
  test_database=${2:-$TEST_DATABASE}
  update_database=${3:-${TEST_DATABASE:+${test_database}_update}}
  update_database=${update_database:-$(checkout_database_name "$TEST_PREFIX" "${module}_update")}
fi
"$name_guard" "$test_database"
if [[ "$update_database" == "${test_database}_update" ]]; then
  require_update_sibling_room "$test_database"
fi
"$name_guard" "$update_database"
if [[ "$test_database" != "$TEST_PREFIX"* || "$update_database" != "$TEST_PREFIX"* ]]; then
  printf 'Verification databases must use the %s prefix.\n' "$TEST_PREFIX" >&2
  exit 2
fi
if [[ "$test_database" == "$update_database" ]]; then
  printf 'Test and update verification require different databases.\n' >&2
  exit 2
fi
if "$compact"; then
  source "$(dirname "$0")/compact.sh"
  log_directory=$(compact_log_directory)
fi
# A disposable pair: the run locks come first and are exclusive (a name another run holds
# exits 2), then both names must be new. Only then are the databases this run's own: the EXIT
# trap drops them (with their filestores) whatever ends the run; before that it removes only
# the locks this run wrote. A signal ends the phase in progress first: Bash runs traps once
# the foreground command returns. The phases (test-module, install-module, update-module) are
# children that may use the reserved names because this process holds their locks.
locked=()
owned=()
discard_disposable_pair() {
  local status=$? database dropped=yes
  trap - EXIT INT TERM
  for database in "${owned[@]}"; do
    python3 -B "$(dirname "$0")/test_temp.py" --discard "$database" "$ODOO_CONFIG" "$PROJECT_ROOT" ||
      dropped=no
  done
  if (( ${#owned[@]} == 0 )); then
    for database in "${locked[@]}"; do
      runtime_state run-unlock "$PROJECT_ROOT" "$database" || { if (( status == 0 )); then status=1; fi; }
    done
  fi
  if "$compact"; then
    printf 'database_lifecycle=disposable dropped=%s\n' "$dropped"
  fi
  if [[ "$dropped" == no ]]; then
    printf 'Cannot drop the disposable databases %s and %s; run odoo19 gc --apply later.\n' \
      "$test_database" "$update_database" >&2
    if (( status == 0 )); then status=1; fi
  fi
  exit "$status"
}
if "$disposable"; then
  trap discard_disposable_pair EXIT
  # A signal between writing a lock and recording it in `locked` would leak that lock: while
  # locking, the signal only sets `pending` and run-lock runs with INT/TERM ignored (a subshell
  # that dies before ignoring them has not written anything); once the lock is recorded, a
  # pending signal ends the run, and the EXIT trap removes the recorded locks.
  pending=''
  trap 'pending=130' INT
  trap 'pending=143' TERM
  for database in "$test_database" "$update_database"; do
    ( trap '' INT TERM; runtime_state run-lock "$PROJECT_ROOT" "$database" "$$" )
    locked+=("$database")
    if [[ -n "$pending" ]]; then exit "$pending"; fi
  done
  trap 'exit 130' INT
  trap 'exit 143' TERM
  # A signal that arrived after the last check above was only recorded: act on it now.
  if [[ -n "$pending" ]]; then exit "$pending"; fi
  require_free_disposable_database "$test_database"
  require_free_disposable_database "$update_database"
  owned=("$test_database" "$update_database")
fi
run_phase() {
  local phase=$1 database=$2
  shift 2
  if "$compact"; then
    local status=0
    "$@" >"$log_directory/$phase.stdout.log" 2>"$log_directory/$phase.stderr.log" || status=$?
    chmod 600 "$log_directory/$phase.stdout.log" "$log_directory/$phase.stderr.log"
    printf 'phase=%s database=%s exit=%s\nstdout_log=%s\nstderr_log=%s\n' \
      "$phase" "$database" "$status" "$log_directory/$phase.stdout.log" "$log_directory/$phase.stderr.log"
    return "$status"
  fi
  printf '\n=== %s (%s) ===\n' "$phase" "$database"
  if "$@"; then
    printf 'phase=%s database=%s exit=0\n' "$phase" "$database"
    return 0
  else
    local status=$?
    printf 'phase=%s database=%s exit=%s\n' "$phase" "$database" "$status" >&2
    return "$status"
  fi
}
test_exit=0
prepare_exit=0
install_exit=0
update_exit=0
run_phase tests "$test_database" "$(dirname "$0")/test-module" "$module" "$test_database" || test_exit=$?
run_phase prepare_update_database "$update_database" reset_test_database "$update_database" || prepare_exit=$?
if (( prepare_exit == 0 )); then
  run_phase fresh_install "$update_database" "$(dirname "$0")/install-module" "$module" "$update_database" || install_exit=$?
else
  install_exit=125
  printf 'phase=fresh_install database=%s exit=125 status=skipped reason=prepare_update_database_failed\n' "$update_database" >&2
fi
if (( install_exit == 0 )); then
  run_phase current_code_update "$update_database" "$(dirname "$0")/update-module" "$module" "$update_database" || update_exit=$?
else
  update_exit=125
  printf 'phase=current_code_update database=%s exit=125 status=skipped reason=fresh_install_failed\n' "$update_database" >&2
fi
printf '\n=== verification summary ===\n'
printf 'module=%s\ntests_database=%s\nupdate_database=%s\nupdate_baseline=current_code_fresh_install\n' "$module" "$test_database" "$update_database"
printf 'tests_exit=%s\nprepare_update_database_exit=%s\nfresh_install_exit=%s\ncurrent_code_update_exit=%s\n' "$test_exit" "$prepare_exit" "$install_exit" "$update_exit"
if (( test_exit != 0 || prepare_exit != 0 || install_exit != 0 || update_exit != 0 )); then exit 1; fi
"$(dirname "$0")/module-status" "$module" "$test_database"
"$(dirname "$0")/module-status" "$module" "$update_database"
