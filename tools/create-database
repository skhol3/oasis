#!/usr/bin/env bash
set -Eeuo pipefail
source "$(dirname "$0")/common.sh"
database=${1:-}
require_runtime
if [[ -z "$database" ]]; then
  printf 'Usage: %s <%s*|%s*>\n' "${ODOO19_ENTRYPOINT:-$0}" "$DEV_PREFIX" "$TEST_PREFIX" >&2
  exit 2
fi
require_managed_database_name "$database"
ensure_database "$database"
printf 'Database ready: %s\n' "$database"
