#!/usr/bin/env bash
set -Eeuo pipefail
if [[ ${1:-} == --help && $# == 1 ]]; then
  printf 'Usage: %s [--compact] <module> <database>\n' "${ODOO19_ENTRYPOINT:-$0}"
  printf 'Updates the module in an existing managed database (dev_prefix/test_prefix, with the\n'
  printf 'checkout slug in a checkout that has one). A missing database is refused, never created.\n'
  printf -- '--compact retains stdout/stderr under odoo19/ of the profile'\''s logs directory (default\n'
  printf 'dev/logs; with [tooling].logs, in odoo19/<slug or main>) and prints the exit code and the\n'
  printf 'two log paths.\n'
  exit 0
fi
source "$(dirname "$0")/common.sh"
compact=false
if [[ ${1:-} == --compact ]]; then compact=true; shift; fi
module=${1:-}
database=${2:-}
require_runtime
require_module "$module"
if [[ -z "$database" ]]; then
  printf 'Usage: %s <module> <database>\n' "${ODOO19_ENTRYPOINT:-$0}" >&2
  exit 2
fi
require_working_database_name "$database"
require_existing_database "$database"
if "$compact"; then
  # Every refusal above happened before a log directory exists.
  source "$(dirname "$0")/compact.sh"
  log_directory=$(compact_log_directory)
  status=0
  bash "$0" "$module" "$database" >"$log_directory/stdout.log" 2>"$log_directory/stderr.log" || status=$?
  chmod 600 "$log_directory/stdout.log" "$log_directory/stderr.log"
  printf 'phase=update database=%s exit=%s\n' "$database" "$status"
  printf 'stdout_log=%s\nstderr_log=%s\n' "$log_directory/stdout.log" "$log_directory/stderr.log"
  exit "$status"
fi
run_odoo -d "$database" -u "$module" --stop-after-init
