#!/usr/bin/env bash
set -Eeuo pipefail
source "$(dirname "$0")/oasis_env.sh"
usage() {
  printf 'Usage: %s gc [--apply] [--all-checkouts] | gc [--apply] --trash [--older-than <days>] [--confirm <project root>]\n' "$(usage_name)"
}
apply=false
scope=checkout
trash=false
older_than=
confirm=
confirmed=false
arguments=("$@")
for (( index = 0; index < ${#arguments[@]}; index++ )); do
  argument=${arguments[index]}
  case $argument in
    --apply) apply=true ;;
    --all-checkouts) scope=all ;;
    --trash) trash=true ;;
    --confirm|--confirm=*)
      if "$confirmed"; then usage >&2; exit 2; fi
      confirmed=true
      if [[ "$argument" == --confirm ]]; then
        index=$(( index + 1 ))
        confirm=${arguments[index]:-}
      else
        confirm=${argument#--confirm=}
      fi
      if [[ -z "$confirm" || "$confirm" == -* ]]; then usage >&2; exit 2; fi ;;
    --older-than)
      index=$(( index + 1 ))
      older_than=${arguments[index]:-}
      # 0 to 36500 days (tools/trash.py MAX_DAYS), checked before any query.
      if [[ ! "$older_than" =~ ^[0-9]{1,9}$ ]] || (( 10#$older_than > 36500 )); then usage >&2; exit 2; fi ;;
    --help)
      usage
      printf 'Lists the disposable test databases (<test_prefix>...<module>_r<6 hex>, and their _update\n'
      printf 'siblings) that no live test-module or verify-module run holds: what a killed run left behind.\n'
      printf 'Only this checkout'\''s namespace by default: <test_prefix><slug>_ in a checkout with a slug;\n'
      printf 'in the main checkout <test_prefix> without the namespaces of its existing linked worktrees.\n'
      printf -- '--all-checkouts lists every namespace of the test prefix. Without --apply nothing changes.\n'
      printf -- '--apply closes their sessions, drops them and removes their filestores ([tooling].data_dir,\n'
      printf 'else the odoo.conf data_dir); a failed drop prints failed <name> on stderr, the others are still dropped,\n'
      printf 'and the run ends with dropped=<n> failed=<m> (exit 1 when m > 0).\n'
      printf 'Development databases and test databases without the run suffix are never\n'
      printf 'touched. A checkout with a slug may drop only its own namespace: run --apply --all-checkouts\n'
      printf 'from the main checkout.\n'
      printf -- '--trash lists the trash entries of this checkout (see trash --help) dropped at least <days>\n'
      printf 'days ago (--older-than, 0 to 36500, default 7), one expired <name> line each, then expired=<n>; with\n'
      printf -- '--apply it closes their sessions, drops them and removes their filestores (dropped <name>, failed\n'
      printf '<name> on stderr, then dropped=<n> failed=<m>, exit 1 when m > 0). A database dropped whose filestore\n'
      printf 'cannot be removed counts as failed: stderr names the filestore path to remove by hand.\n'
      printf 'Without --trash the trash is never touched.\n'
      printf -- '--apply --trash is Tier B in the agent policy (oasis policy --json): it runs only with\n'
      printf -- '--confirm <project root>; without it, it refuses before any query naming the exact command.\n'
      exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
if { [[ -n "$older_than" ]] && ! "$trash"; } || { "$trash" && [[ "$scope" == all ]]; } \
    || { "$confirmed" && ! { "$apply" && "$trash"; }; }; then
  usage >&2
  exit 2
fi
source "$(dirname "$0")/common.sh"
# Tier B (tools/policy.py): dropping the trash for good needs --confirm <project root>, before any query.
if "$apply" && "$trash" && [[ "${confirm%/}" != "$PROJECT_ROOT" ]]; then
  days=()
  if [[ -n "$older_than" ]]; then days=(--older-than "$older_than"); fi
  command=$(confirm_command gc --apply --trash "${days[@]}" --confirm "$PROJECT_ROOT")
  if "$confirmed"; then
    printf 'ERROR: --confirm %s does not name the project root %s; nothing changed. Run: %s\n' \
      "$confirm" "$PROJECT_ROOT" "$command" >&2
  else
    printf 'ERROR: gc --apply --trash drops the expired trash entries for good (Tier B: it needs explicit confirmation); nothing changed. List them with %s, then run: %s\n' \
      "$(confirm_command gc --trash "${days[@]}")" "$command" >&2
  fi
  exit 2
fi
require_runtime
if "$trash"; then
  trash_helper() {
    python3 -B "$(dirname "$0")/trash.py" "$@"
  }
  rows=$(list_trash_databases)
  expired=$(trash_helper expired "$PROJECT_ROOT" "$DEV_PREFIX" "$TEST_PREFIX" "${CHECKOUT_SLUG:-}" "${older_than:-7}" \
    <<< "$rows")
  count=0
  failed=0
  mapfile -t expired_list <<< "$expired"
  for database in "${expired_list[@]}"; do
    [[ -n "$database" ]] || continue
    if "$apply"; then
      # drop_trash_database repeats the namespace and trash-name guards. A filestore left after
      # the drop (purge exit 3) is a failure too; purge named its path on stderr.
      if trash_helper purge "$ODOO_CONFIG" "$database" </dev/null; then
        printf 'dropped %s\n' "$database"
        count=$(( count + 1 ))
      else
        printf 'failed %s\n' "$database" >&2
        failed=$(( failed + 1 ))
      fi
    else
      printf 'expired %s\n' "$database"
      count=$(( count + 1 ))
    fi
  done
  if "$apply"; then
    printf 'dropped=%s\nfailed=%s\n' "$count" "$failed"
    if (( failed > 0 )); then exit 1; fi
  else
    printf 'expired=%s\n' "$count"
  fi
  exit 0
fi
if "$apply" && [[ "$scope" == all && -n "${CHECKOUT_SLUG:-}" ]]; then
  printf 'Checkout %s may drop only its own databases (%s%s_*); run gc --apply --all-checkouts from the main checkout.\n' \
    "$CHECKOUT_SLUG" "$TEST_PREFIX" "$CHECKOUT_SLUG" >&2
  exit 2
fi
gc_helper() {
  python3 -B "$(dirname "$0")/gc.py" "$@"
}
databases=$(list_managed_databases)
orphans=$(gc_helper orphans "$PROJECT_ROOT" "$TEST_PREFIX" "${CHECKOUT_SLUG:-}" "$scope" "$TEST_DATABASE" \
  <<< "$databases")
count=0
failed=0
mapfile -t orphan_list <<< "$orphans"
for database in "${orphan_list[@]}"; do
  [[ -n "$database" ]] || continue
  if "$apply"; then
    # drop_disposable_database repeats the managed-name, namespace and run-suffix guards.
    # A failed drop is reported and the next orphan is still dropped.
    if gc_helper discard "$ODOO_CONFIG" "$database" </dev/null; then
      printf 'dropped %s\n' "$database"
      count=$(( count + 1 ))
    else
      printf 'failed %s\n' "$database" >&2
      failed=$(( failed + 1 ))
    fi
  else
    printf 'orphan %s\n' "$database"
    count=$(( count + 1 ))
  fi
done
if "$apply"; then
  printf 'dropped=%s\nfailed=%s\n' "$count" "$failed"
  if (( failed > 0 )); then exit 1; fi
else
  printf 'orphans=%s\n' "$count"
fi
