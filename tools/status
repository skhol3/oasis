#!/usr/bin/env bash
set -Eeuo pipefail
source "$(dirname "$0")/common.sh"
require_runtime
# This checkout's server first, then, in a git checkout, the servers of every checkout of the
# repository (runtime_state servers: main and linked worktrees, this one marked), then the shared
# Compose services. A project outside git shows only its own line.
# A failing runtime state read degrades to `server: unknown (<reason>)`; compose ps still runs.
# stdout and stderr are read separately: stderr is the reason only when the read fails;
# after a successful read it is passed through unchanged. They are captured without a
# temporary file, so a missing or non-writable TMPDIR cannot hide the server line or
# compose ps: the process substitution writes <stderr> NUL <stdout> NUL <status> NUL.
state_error='' server='' state_status=0
{
  IFS=$'\n' read -r -d '' state_error || true
  IFS=$'\n' read -r -d '' server || true
  IFS=$'\n' read -r -d '' state_status || true
} < <(
  {
    status=0
    output=$(runtime_state show "$PROJECT_ROOT") || status=$?
    printf '\0%s\0%s\0' "$output" "$status"
  } 2>&1
)
if [[ ! "$state_status" =~ ^[0-9]+$ ]]; then state_status=1; fi
if (( state_status != 0 )); then
  reason=$(printf '%s\n' "$state_error" | sed '/^[[:space:]]*$/d' | tail -n 1)
  reason=${reason#ERROR: }
  printf 'server: unknown (%s)\n' "${reason:-runtime_state.py exited with $state_status}"
elif [[ -n "$server" ]]; then
  server_pid=${server%% *}
  server_port=${server#* }
  printf 'server: running pid %s port %s\n' "${server_pid#pid=}" "${server_port#port=}"
else
  printf 'server: stopped\n'
fi
if (( state_status == 0 )) && [[ -n "$state_error" ]]; then
  printf '%s\n' "$state_error" >&2
fi
if [[ "${CHECKOUT_KIND:-}" == main || "${CHECKOUT_KIND:-}" == linked ]]; then
  # Read as the server line is: only stdout lists servers; stderr is the reason of a failure
  # (git cannot list the worktrees, an unreadable state) and, after a success, a warning passed
  # through to stderr unchanged.
  servers_error='' servers='' servers_status=0
  {
    IFS=$'\n' read -r -d '' servers_error || true
    IFS=$'\n' read -r -d '' servers || true
    IFS=$'\n' read -r -d '' servers_status || true
  } < <(
    {
      status=0
      output=$(runtime_state servers "$PROJECT_ROOT") || status=$?
      printf '\0%s\0%s\0' "$output" "$status"
    } 2>&1
  )
  if [[ ! "$servers_status" =~ ^[0-9]+$ ]]; then servers_status=1; fi
  if (( servers_status != 0 )); then
    reason=$(printf '%s\n' "$servers_error" | sed '/^[[:space:]]*$/d' | tail -n 1)
    reason=${reason#ERROR: }
    printf 'repository servers: unknown (%s)\n' "${reason:-runtime_state.py exited with $servers_status}"
  else
    if [[ -n "$servers_error" ]]; then printf '%s\n' "$servers_error" >&2; fi
    count=0
    lines=()
    while IFS= read -r line; do
      if [[ -n "$line" ]]; then lines+=("  $line"); count=$(( count + 1 )); fi
    done <<< "$servers"
    printf 'repository servers: %s\n' "$count"
    if (( count > 0 )); then printf '%s\n' "${lines[@]}"; fi
  fi
fi
compose ps
